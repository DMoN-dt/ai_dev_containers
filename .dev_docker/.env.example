# Настройки Environment для контейнеров разработки

##### Общие настройки #####
PROJECT_NAME=blazing_star_project
RAILS_LOG_MAX_SIZE=10485760

TIMEZONE=Europe/Moscow

# Пути для контейнеров (могут быть как относительными, так и абсолютными)
APP_DOCKER_CONTEXT=.
APP_DOCKER_FILE=.dev_docker/Dockerfile.dev.app
POSTGRES_DOCKER_CONTEXT=.
POSTGRES_DOCKER_FILE=.dev_docker/Dockerfile.dev.db
DEV_DOCKER_TOOLS_PATH=./.dev

##### Настройки БД для разработки #####

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=pgadmin_password

POSTGRES_DB_DEVELOPMENT=blazing_star_project_development
POSTGRES_DB_TEST=blazing_star_project_test

POSTGRES_EXTERNAL_PORT=5432
REDIS_EXTERNAL_PORT=6379


##### Настройки AI #####

## Сюда добавьте настройки для AI-агентов, если они нужны.

